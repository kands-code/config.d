[Unit]
Description=Mihomo daemon
Documentation=https://wiki.metacubex.one/
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# 按实际安装路径修改；配置目录与 config.yaml 请与 ExecStart 对应
ExecStart=/usr/local/bin/mihomo -d /etc/mihomo -f /etc/mihomo/config.yaml
WorkingDirectory=/etc/mihomo
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576

# TUN / 监听 53 端口所需的最小能力；若以 root 运行可保留，无副作用
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE

# 允许 Mihomo 写自身配置目录（下载 provider、规则集、cache 等）
ReadWritePaths=/etc/mihomo

[Install]
WantedBy=multi-user.target
