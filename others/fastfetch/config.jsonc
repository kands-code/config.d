{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 2,
      "left": 2,
      "right": 2
    }
  },
  "display": {
    "separator": " ~> ",
    "temp": {
      "unit": "K"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "-- {home-dir} --"
    },
    {
      "type": "host",
      "key": "pc",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": "with",
      "format": "{sysname} {release}"
    },
    {
      "type": "packages",
      "key": "pkgs"
    },
    {
      "type": "shell",
      "key": "sh",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": "wm",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "terminal",
      "key": "term",
      "format": "{pretty-name}"
    },
    {
      "type": "cpu",
      "key": "cpu",
      "temp": true,
      "format": "{name} ({cores-online}) @ {freq-max} [{temperature}]"
    },
    {
      "type": "gpu",
      "key": "gpu",
      "temp": true,
      "format": "{type} ({driver}) @ [{temperature}]"
    },
    {
      "type": "memory",
      "key": "mem",
      "format": "{used} ({percentage})"
    },
    {
      "type": "disk",
      "key": "disk",
      "format": "{size-used} [{filesystem}] ({size-percentage})"
    }
  ]
}
